{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "hooks/*.ts",
    "commands/scripts/*.ts",
    "scripts/*.ts"
  ],
  "project": [
    "hooks/**/*.ts",
    "commands/**/*.ts",
    "scripts/**/*.ts",
    "lib/**/*.ts",
    "test-utils/**/*.ts",
    "types.ts"
  ],
  "ignore": [
    "**/*.md",
    ".claude/**",
    "templates/**",
    "docs/**",
    "dist/**"
  ],
  "ignoreDependencies": [
    "ccusage",
    "@semantic-release/github"
  ],
  "ignoreExportsUsedInFile": true
}